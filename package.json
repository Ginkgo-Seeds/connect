{
  "name": "ginkgo-connect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.17.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "deps:check": "manypkg check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run format:check && pnpm run deps:check && eslint . --max-warnings 0 && turbo run lint",
    "test": "vitest run tests/architecture/dependency-boundaries.test.ts && turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@manypkg/cli": "0.25.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
