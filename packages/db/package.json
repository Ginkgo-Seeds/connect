{
  "name": "@connect/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm prisma:generate && tsc6 -p tsconfig.json",
    "lint": "eslint src test prisma.config.ts --max-warnings 0",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "test": "vitest run",
    "typecheck": "tsc6 -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@connect/core": "workspace:*",
    "@connect/shared": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/pg": "8.15.5",
    "dotenv": "17.2.3",
    "prisma": "7.9.1"
  }
}
